# Local-first defaults: no external services required.
TALENTOS_DATA_DIR=./data
TALENTOS_DB_PATH=./data/talentos.db
TALENTOS_STORAGE_DIR=./data/storage
TALENTOS_RUBRIC_TOLERANCE=1e-6
TALENTOS_INDEX_PATH=./data/hybrid_index.json
# Only the deterministic offline extractor is bundled. Other values fail fast
# instead of calling any external/paid inference service.
TALENTOS_INFERENCE_BACKEND=offline
TALENTOS_MAX_BATCH_SIZE=50
